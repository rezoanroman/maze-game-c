include<stdio.h>
#include<stdlib.h>
#include<string.h>

#define ROWS 15
#define COLS 29
#define SIZE 3

typedef struct{
    int r,c;
}pos;

char mz[ROWS][COLS];
pos startp,exitp,player;
pos st[ROWS*COLS];
int top=-1;
int moves=0;

void push(pos p);
int pop(pos *p);
int inb(int r,int c);
int wall(char ch);
pos find_char(char target);
void maze();
void draw();
void move(char ch);
void undo_move();
void play();
void menu();

void push_score(int score);
void print_scores();
void banner();
void cls();

int main(){
    maze();
    startp=find_char('S');
    exitp=find_char('E');

    if(startp.r<0 || exitp.r<0){
        printf("maze build error\n");
        return 1;
    }
    banner();

    while(1){
        menu();
        int op;
        if(scanf("%d",&op)!=1)
            break;
        switch(op){
            case 0:
                return 0;
            case 1:
                play();
                break;
            case 2:
                print_scores();
                break;
            default:
                printf("invalid\n");
                break;
        }
    }
    return 0;
}

void push(pos p){
    if(top<ROWS*COLS-1)
        st[++top]=p;
}

int pop(pos *p){
    if(top<0)
        return 0;
    *p=st[top--];
    return 1;
}

int inb(int r,int c){
    return r >= 0 && r<ROWS && c >= 0 && c<COLS;
}

int wall(char ch){
    return ch == '-' || ch == '|' || ch == '+';
}

pos find_char(char target){
    for(int r=0;r<ROWS;r++)
        for(int c=0;c<COLS;c++)
            if(mz[r][c]==target)
                return (pos){r,c};
    return (pos){-1,-1};
}

void maze(void){
    for(int r=0;r<ROWS;r++)
        for(int c=0;c<COLS;c++)
            mz[r][c]=' ';

    mz[0][0]=mz[0][COLS-1]=mz[ROWS-1][0]=mz[ROWS-1][COLS-1]='+';
    for(int c=1; c<COLS-1;c++){
        mz[0][c]='-';
        mz[ROWS - 1][c]='-';
    }
    for(int r=1;r<ROWS-1;r++){
        mz[r][0]='|';
        mz[r][COLS-1] ='|';
    }

    int L=3,R=COLS-4;
    int rows[]={2,4,6,8,10,12};
    for(int i=0;i<6;i++){
        int rr=rows[i];
        for(int c=1;c<COLS-1;c++)
            mz[rr][c]='-';
        mz[rr][(i % 2 == 0) ? R:L]=' ';
    }

    mz[1][1]='S';
    mz[ROWS-2][COLS-2]='E';
}

void draw(){
    cls();
    for(int r=0;r<ROWS;r++){
        printf("\t\t\t\t\t\t\t\t\t\t\t");
        for(int c=0;c<COLS;c++){
            if(r == player.r && c == player.c)
                putchar('P');
            else
                putchar(mz[r][c]);
        }
        putchar('\n');
    }
    printf("\n\t\t\t\t\t\t\t\t\t\t\tmoves: %d  |  w a s d = move, u = undo, q = quit\n", moves);
}

void move(char ch){
    int dr=0,dc=0;
    if(ch=='w') dr=-1;
    else if(ch =='s') dr=1;
    else if(ch =='a') dc=-1;
    else if(ch =='d') dc=1;
    else return;

    int nr=player.r+dr,nc=player.c+dc;
    if(!inb(nr,nc))
        return;
    if(!wall(mz[nr][nc])){
        push(player);
        player=(pos){nr, nc};
        moves++;
    }
}

void undo_move(void){
    pos prev;
    if(pop(&prev)){
        player=prev;
        if(moves>0)
            moves--;
    }
}

void play(){
    player=startp;
    top=-1;
    moves=0;
    while(1){
        draw();
        if(player.r==exitp.r && player.c==exitp.c){
            printf("\t\t\t\t\t\t\t\t\t\t\tescaped! total moves: %d\n",moves);
            printf("\t\t\t\t\t\t\t\t\t\t\tpress enter to continue......");
            getchar();
            getchar();
            break;
        }
        char ch;
        printf("\n\t\t\t\t\t\t\t\t\t\t\tEnter move: ");
        if(scanf(" %c",&ch)!=1)
            break;
        if(ch=='q')
            break;
        else if(ch=='u')
            undo_move();
        else
            move(ch);
    }
    push_score(moves);
}

void menu(){
    printf("\n\n");
    printf("\t\t\t\t\t\t\t\t\t\t\t1 play\n");
    printf("\t\t\t\t\t\t\t\t\t\t\t2 view last 3 scores\n");
    printf("\t\t\t\t\t\t\t\t\t\t\t0 exit\n\t\t\t\t\t\t\t\t\t\t\tEnter your choice: ");
}

typedef struct{
    int a[SIZE];
    int front;
    int count; 
}score_queue;

static score_queue last3={.front = 0,.count = 0 };

void push_score(int score){
    if(last3.count<SIZE){
        int index=(last3.front+last3.count)% SIZE;
        last3.a[index]=score;
        last3.count++;
    }
    else{
        last3.a[last3.front]=score;
        last3.front=(last3.front+1)% SIZE;
    }
}

void print_scores(){
    if(last3.count == 0){
        printf("\t\t\t\t\t\t\t\t\t\t\tno scores yet\n");
        return;
    }
    printf("\t\t\t\t\t\t\t\t\t\t\tlast %d game scores :\n",last3.count);
    for(int i=0;i<last3.count;i++){
        int index=(last3.front+i) % SIZE;
        printf("\t\t\t\t\t\t\t\t\t\t\t%d %d\n",i+1,last3.a[index]);
    }
}

